{% render 'site-header' %}
<main id="main" class="cart-page">
<section class="page-head"><div class="wrap">
 <span class="label eyebrow">Basket</span>
 <h1 class="disp">Your basket.</h1>
</div></section>
{%- if cart.item_count == 0 -%}
<section style="padding-top:0;border-top:0"><div class="wrap prose">
 <p class="pull">Your basket is empty.</p>
 <p>Every SATU piece is made to order in repurposed teak.</p>
 <div class="btns" style="margin-top:28px"><a class="btn" href="/collections/all">See the SATU collection</a><a class="tlink" href="/pages/contact">Ordering for a project? Ask for a quote</a></div>
</div></section>
{%- else -%}
<section style="padding-top:0;border-top:0"><div class="wrap">
<form action="{{ routes.cart_url }}" method="post" class="cart-grid" id="cart">
 <div class="cart-items">
  <div class="cart-colhead label muted"><span>Piece</span><span>Total</span></div>
  <ul class="bag-list">
  {%- for item in cart.items -%}
   <li class="bag-item">
    <a class="bag-img" href="{{ item.url | split: '?' | first }}">{%- if item.image -%}<img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.product.title | escape }}" width="96" height="96" loading="lazy">{%- endif -%}</a>
    <div class="bag-info">
     <div class="bag-top"><a class="bag-title" href="{{ item.url | split: '?' | first }}">{{ item.product.title }}</a><span class="bag-line">{{ item.final_line_price | money_with_currency }}</span></div>
     <span class="cap">{{ item.final_price | money_with_currency }} each</span>
     <div class="bag-ctrl">
      <div class="qty"><a class="qty-b" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity={{ item.quantity | minus: 1 }}" aria-label="One fewer">&minus;</a><span class="qty-v">{{ item.quantity }}</span><a class="qty-b" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity={{ item.quantity | plus: 1 }}" aria-label="One more">+</a></div>
      <a class="tlink cap" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0">Remove</a>
     </div>
    </div>
   </li>
  {%- endfor -%}
  </ul>
  <div class="field cart-note"><label for="cart-note">Note for us <span class="muted">(optional)</span></label><textarea id="cart-note" name="note" placeholder="Delivery wishes, the space, anything we should know">{{ cart.note }}</textarea></div>
 </div>
 <aside class="cart-sum">
  <span class="label">Order summary</span>
  <dl class="sum-rows">
   <div><dt>Subtotal</dt><dd>{{ cart.items_subtotal_price | money_with_currency }}</dd></div>
   {%- if cart.cart_level_discount_applications.size > 0 -%}{%- for d in cart.cart_level_discount_applications -%}<div><dt>{{ d.title }}</dt><dd>&minus;{{ d.total_allocated_amount | money_with_currency }}</dd></div>{%- endfor -%}{%- endif -%}
   <div><dt>Delivery</dt><dd>{{ 20000 | money_with_currency }}</dd></div>
   <div><dt>Delivery time</dt><dd>14 weeks</dd></div>
   <div class="sum-total"><dt>Total</dt><dd>{{ cart.total_price | plus: 20000 | money_with_currency }}</dd></div>
  </dl>
  <p class="cap">Prices in USD, excl. VAT. VAT and import duty are added at checkout where they apply. Every piece is made to order and delivered 14 weeks after your order. Discount codes can be entered at checkout.</p>
  <button class="btn btn-wide" type="submit" name="checkout">Checkout</button>
  <a class="tlink cap" href="/collections/all">Continue browsing</a>
  <a class="tlink cap" href="/pages/contact">Ordering for a hotel or project? Ask for a quote</a>
 </aside>
 <div class="cart-bar"><div><span class="cap">Total</span><strong>{{ cart.total_price | plus: 20000 | money_with_currency }}</strong></div><button class="btn" type="submit" name="checkout">Checkout</button></div>
</form>
</div></section>
{%- endif -%}
</main>
{% render 'site-footer' %}
{% render 'site-scripts' %}
