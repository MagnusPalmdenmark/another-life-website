{% layout 'theme' %}

<a class="skip" href="#main">Skip to content</a>
<header class="site-head" id="site-head"><div class="wrap head-row">
<a class="brand" href="/" aria-label="Another Life, home"><img class="wordmark" src="{{ 'logo-wordmark.png' | asset_url }}" alt="ANOTHER — LIFE" width="1200" height="149"></a>
<nav class="nav" aria-label="Main"><a class="label" href="/collections/all">Collection</a><a class="label" href="/pages/in-use">In use</a><a class="label" href="/pages/mission">Mission</a><a class="label" href="/pages/material">Material</a><a class="label" href="/pages/passport">Passport</a><a class="label" href="/pages/hospitality">Hospitality</a><a class="label" href="/pages/contact" aria-current=page>Contact</a></nav>
<span class="head-end"><a class="bag" href="/cart" aria-label="Basket"><svg viewBox="0 0 20 22" aria-hidden="true"><path d="M2.5 7.5h15l-1.2 13H3.7z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M6.5 7.5V5.2a3.5 3.5 0 0 1 7 0v2.3" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><span class="bag-n" data-bag-n hidden>0</span></a><script>(function(){try{var b=JSON.parse(localStorage.getItem("al-basket")||"[]"),n=b.reduce(function(s,i){return s+(i.q||0)},0);document.querySelectorAll("[data-bag-n]").forEach(function(e){e.textContent=n;e.hidden=!n;});}catch(e){}})();</script><svg class="bdots" id="bdots" viewBox="0 0 30 27" aria-hidden="true"><circle class="d0" cx="15" cy="6" r="4.2"/><circle class="d1" cx="25" cy="22" r="4.2"/><circle class="d2" cx="5" cy="22" r="4.2"/></svg></span>
</div></header>
<main id="main">

<section class="page-head"><div class="wrap">
 <span class="label eyebrow">Contact</span>
 <h1 class="disp">Tell us what you're building.</h1>
</div></section>
<section style="padding-top:0;border-top:0"><div class="wrap split">
 <div>
  <p class="prose">Contact us and tell us what you are furnishing, where and when. We work with hotels, resorts, restaurants and cafés, and with the architects and designers who furnish them.</p>
  <p class="prose">Running a planting project, a community initiative or something else that fits our mission? Choose Collaboration and say hello.</p>
  <div class="lead-img"><figure class="fig"><img src="{{ 'chair-seawall-step.jpg' | asset_url }}" alt="A woman in a long dress stepping barefoot off The Chair on a sea wall, a beach and a sailboat behind" width="1004" height="781" loading="lazy"><figcaption class="cap">Come and say hello.</figcaption></figure></div>
  <div style="margin-top:32px"><dl class="ledger"><div><dt>WhatsApp</dt><dd><span data-obf="NTAgNDAgMzUgMDMgNTQr" data-t="text">via the button below</span></dd></div><div><dt>Email</dt><dd><span data-obf="a2QuZWZpbC1yZWh0b25hQG9sbGVo" data-t="mail">via the button below</span></dd></div><div><dt>Made in</dt><dd>Indonesia</dd></div></dl></div>
 </div>
 <div>
  {%- form 'contact', id: 'enq', class: 'enq-form' -%}
  {%- if form.posted_successfully? -%}
   <div class="out"><span class="label">Sent</span><p class="pull" style="margin:0">Thank you. Your message is with us.</p><p class="cap">We reply by email, usually within two working days.</p></div>
  {%- else -%}
   {%- if form.errors -%}<p class="cap form-err">{{ form.errors | default_errors }}</p>{%- endif -%}
   <input type="hidden" name="contact[Request]" value="Message from the contact page">
   <div class="quote-fields">
   {% render 'quote-fields', form: form %}
   <input type="hidden" name="contact[About piece]" id="q-piece" disabled>
   <div class="field"><label for="f-msg">About the project</label><textarea id="f-msg" name="contact[body]" placeholder="The space, quantities, timeline"></textarea></div>
   <div class="btns"><button class="btn" type="submit">Send message</button><a class="tlink" href="/pages/contact" data-obf="NTA0MDM1MDM1NA==" data-t="wa">Or message us on WhatsApp</a></div>
   </div>
  {%- endif -%}
  {%- endform -%}
 </div>
</div></section>
<script>
(function(){
 var q=(location.search.match(/piece=([a-z-]+)/)||[])[1]; if(q){var h=document.getElementById('q-piece'); if(h){h.value=q.replace(/-/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase()}); h.disabled=false;} var m=document.getElementById('f-msg'); if(m&&!m.value) m.placeholder='Your question about '+h.value;}
 if(/type=collab/.test(location.search)){var t=document.getElementById('q-type'); if(t)t.value='Collaboration';}
})();
</script>

</main>
<footer><div class="wrap">
<div class="foot">
 <ul class="foot-links"><li><a href="/collections/all">Collection</a></li><li><a href="/pages/passport">Passport</a></li><li><a href="/pages/faq">FAQ</a></li><li><a href="/pages/contact">Contact</a></li><li><a href="/pages/contact" data-obf="NTA0MDM1MDM1NA==" data-t="wa">WhatsApp</a></li></ul>
</div>
<div class="foot-base"><span class="label">Danish design · Made in Indonesia</span><span class="label muted">Make it once. Let it live.</span></div>
</div></footer>
