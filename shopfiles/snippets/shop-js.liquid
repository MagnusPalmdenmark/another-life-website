<script>
(function(){
 function setCount(n){document.querySelectorAll('[data-bag-n]').forEach(function(e){e.textContent=n;e.hidden=!n;});}
 document.querySelectorAll('.buy .qty').forEach(function(q){var i=q.querySelector('input');if(!i)return;q.querySelectorAll('[data-q]').forEach(function(b){b.addEventListener('click',function(){i.value=Math.max(1,(parseInt(i.value,10)||1)+parseInt(b.getAttribute('data-q'),10));});});});
 document.querySelectorAll('form[data-buy]').forEach(function(f){f.addEventListener('submit',function(ev){
  if(!window.fetch||!f.querySelector('[name=quantity]'))return; ev.preventDefault(); var b=f.querySelector('button[type=submit]'); b.disabled=true;
  fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:+f.id.value,quantity:Math.max(1,parseInt(f.quantity.value,10)||1)}]})})
   .then(function(r){return r.json().then(function(j){if(!r.ok)throw j;return j;});})
   .then(function(){return fetch('/cart.js').then(function(r){return r.json();});})
   .then(function(c){setCount(c.item_count);var m=f.querySelector('[data-buy-msg]');m.hidden=false;m.firstChild.textContent='Added to your basket. ';f.quantity.value=1;})
   .catch(function(e){var m=f.querySelector('[data-buy-msg]');m.hidden=false;m.firstChild.textContent=(e&&e.description?e.description:'Could not add this piece.')+' ';})
   .then(function(){b.disabled=false;});
 });});
})();
</script>
